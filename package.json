{
  "name": "wt-content-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx test/install.smoke.ts",
    "smoke:config": "tsx test/config.smoke.ts",
    "smoke:real": "tsx test/realdir.smoke.ts",
    "smoke:ui": "tsx test/ui.smoke.ts",
    "smoke:validate": "tsx test/validate.smoke.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --publish never",
    "release": "npm run build && electron-builder --publish always",
    "smoke:sight": "tsx test/sight.smoke.ts",
    "smoke:sight-overwrite": "tsx test/sight-overwrite.smoke.ts",
    "smoke:network": "tsx test/network.smoke.ts",
    "smoke:sound": "tsx test/sound.smoke.ts",
    "smoke:sound-install": "tsx test/sound-install.smoke.ts",
    "smoke:sound-slots": "tsx test/sound-slots.smoke.ts",
    "smoke:vehicle": "tsx test/vehicle.smoke.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "main": "out/main/index.js",
  "productName": "War Thunder Content Manager",
  "description": "Browse and install War Thunder Live community content in one click.",
  "build": {
    "appId": "dev.nicolasjory.wtcontentmanager",
    "productName": "War Thunder Content Manager",
    "copyright": "Copyright © 2026 Nicolas Jory",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "NicolasJory",
        "repo": "war-thunder-content-manager"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "WTContentManager-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WT Content Manager",
      "artifactName": "WTContentManager-${version}-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "include": "build/installer.nsh"
    },
    "protocols": [
      {
        "name": "War Thunder Content Manager",
        "schemes": [
          "wtcm"
        ]
      }
    ],
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "WTContentManager-${version}.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "portable": {
      "artifactName": "WTContentManager-${version}-Portable.${ext}",
      "unpackDirName": "WTContentManager"
    }
  },
  "license": "GPL-3.0-or-later",
  "author": "Nicolas Jory",
  "repository": {
    "type": "git",
    "url": "https://github.com/NicolasJory/war-thunder-content-manager.git"
  },
  "homepage": "https://github.com/NicolasJory/war-thunder-content-manager",
  "bugs": {
    "url": "https://github.com/NicolasJory/war-thunder-content-manager/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
